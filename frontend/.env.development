# Defaults for `npm run dev` only (`npm run build` ignores this file).
# To change a value on your machine, put it in .env.local instead of editing this file.

# Where `npm run dev` forwards /api/* requests (the API gateway).
API_GATEWAY_URL=http://localhost:8080

# The backend does not exist yet, so the UI opens as a fake signed-in user.
# Set to false once the API gateway is running. Role: teacher or student.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH_ROLE=teacher
